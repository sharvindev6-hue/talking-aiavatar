# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# NVIDIA NIM Kimi LLM
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Kimi (moonshotai/kimi-k2.6) is unstable on NVIDIA NIM — use Llama for reliable replies
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Vision model used automatically when an image is attached (must support image_url)
VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# Server
PORT=3000

# Security
# OPTIONAL: strict allowlist of origins allowed to call the API with cookies
# (comma-separated). If left empty, the app accepts same-origin requests only
# (Origin must match the request's own Host), which works on any domain —
# localhost, Vercel main + preview URLs — with zero config. Set this to your
# production domain(s) once you have a stable URL for a strict allowlist.
ALLOWED_ORIGINS=
# Set to true when running behind a reverse proxy (Vercel/nginx) so
# IP-based rate limits see the real client IP via X-Forwarded-For.
TRUST_PROXY=false

# Admin dashboard
# Comma-separated emails of users who can open /admin.html (analytics +
# per-user chat history). E.g. ADMIN_EMAILS=you@example.com,colead@example.com
ADMIN_EMAILS=

# Database (Neon Postgres — required for accounts & chat history)
# Create a free project at https://neon.tech, then paste the pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# Optional: NVIDIA Audio2Face-3D NIM (requires separate deployment)
A2F_ENABLED=false
A2F_NIM_URL=
